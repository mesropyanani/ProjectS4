@api_view(['GET'])
def subject_resources(request, subject):
    if subject.lower() == "mathematics":
        return Response({
            "subject": "Mathematics",
            "resources": [
                {"type": "Textbooks", "icon": "⏸️"},
                {"type": "Videos", "icon": "▶️"},
                {"type": "Additional Materials", "icon": "📂"},
                {"type": "Chat with Teacher", "icon": "💬"},
                {"type": "Geography", "icon": "🗺️"},
            ]
        })
    else:
        return Response({
            "subject": subject,
            "resources": [
                {"type": "Textbooks", "icon": "📘"},
                {"type": "Videos", "icon": "🎥"},
                {"type": "Additional Materials", "icon": "📁"},
